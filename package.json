    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  }
